{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript",
    "plugin:storybook/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "rules": {
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "target": [
              "./src/renderer",
              "./src/features/*/renderer/**/*"
            ],
            "from": "./src/main",
            "message": "The renderer has no Node.js. Reach the main process through the preload bridge on `window.pbnotes`."
          },
          {
            "target": [
              "./src/renderer",
              "./src/features/*/renderer/**/*"
            ],
            "from": "./src/preload",
            "message": "The preload bundle is not importable from the renderer; its only surface is what `contextBridge` exposes."
          },
          {
            "target": [
              "./src/main",
              "./src/features/*/main/**/*"
            ],
            "from": "./src/renderer",
            "message": "The main process has no DOM. Move anything both sides need into `src/shared`."
          },
          {
            "target": [
              "./src/main",
              "./src/features/*/main/**/*"
            ],
            "from": "./src/preload",
            "message": "Preload and main are separate bundles. Share code through `src/shared` instead."
          },
          {
            "target": [
              "./src/preload",
              "./src/features/*/preload.ts"
            ],
            "from": "./src/main",
            "message": "Preload runs in the renderer's process and must not pull in main-process code (or the Node modules behind it)."
          },
          {
            "target": [
              "./src/preload",
              "./src/features/*/preload.ts"
            ],
            "from": "./src/renderer",
            "message": "Preload runs before the app does and must not import renderer code."
          },
          {
            "target": [
              "./src/shared",
              "./src/features/*/contract.ts"
            ],
            "from": "./src/main",
            "message": "`src/shared` is bundled into every process, so it can depend on none of them."
          },
          {
            "target": [
              "./src/shared",
              "./src/features/*/contract.ts"
            ],
            "from": "./src/preload",
            "message": "`src/shared` is bundled into every process, so it can depend on none of them."
          },
          {
            "target": [
              "./src/shared",
              "./src/features/*/contract.ts"
            ],
            "from": "./src/renderer",
            "message": "`src/shared` is bundled into every process, so it can depend on none of them."
          },
          {
            "target": [
              "./src/renderer",
              "./src/features/*/renderer/**/*"
            ],
            "from": [
              "./src/features/*/main/**/*",
              "./src/features/*/preload.ts"
            ],
            "message": "A slice's renderer files have no Node.js. Inside a slice, `main/`, `preload.ts` and `renderer/` share only `contract.ts`."
          },
          {
            "target": [
              "./src/main",
              "./src/features/*/main/**/*"
            ],
            "from": [
              "./src/features/*/renderer/**/*",
              "./src/features/*/preload.ts"
            ],
            "message": "A slice's main files have no DOM. Inside a slice, `main/`, `preload.ts` and `renderer/` share only `contract.ts`."
          },
          {
            "target": [
              "./src/preload",
              "./src/features/*/preload.ts"
            ],
            "from": [
              "./src/features/*/main/**/*",
              "./src/features/*/renderer/**/*"
            ],
            "message": "Preload is a bundle of its own. Inside a slice, `main/`, `preload.ts` and `renderer/` share only `contract.ts`."
          },
          {
            "target": [
              "./src/shared",
              "./src/features/*/contract.ts"
            ],
            "from": [
              "./src/features/*/main/**/*",
              "./src/features/*/preload.ts",
              "./src/features/*/renderer/**/*"
            ],
            "message": "A contract is bundled into every process, so it can depend on none of them."
          },
          {
            "target": "./src/shared",
            "from": "./src/features",
            "message": "`src/shared` knows no feature. A feature's types and names live in its own `contract.ts`."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/renderer/**",
        "src/preload/**",
        "src/shared/**",
        "src/features/*/renderer/**",
        "src/features/*/preload.ts",
        "src/features/*/contract.ts"
      ],
      "rules": {
        "@typescript-eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@pbnotes/ledger",
                "allowTypeImports": true,
                "message": "The ledger runs on Node. Outside main, take its types only, with `import type`."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "vite.*.config.ts",
        "vite.*.config.mts",
        "forge.config.ts",
        ".storybook/main.ts"
      ],
      "rules": {
        "import/no-unresolved": "off"
      }
    }
  ]
}
