# Maintainer: Sal Rahman <hey.to.sal@gmail.com>
#
# Pb Notes on the AUR (#361), repackaged from the .deb on the GitHub Release.
# Edit this copy, never the AUR's: when a Release is published,
# .github/workflows/aur.yml sets pkgver, fills in the checksums from that
# Release's files (update.sh) and pushes the result to the AUR.

pkgname=pbnotes-bin
_pkgname=pbnotes
pkgver=0.6.2
pkgrel=1
pkgdesc='Local-first knowledge sharing and management, safe for many writers.'
arch=('x86_64' 'aarch64')
url='https://github.com/shovon/pbnotes'
license=('MIT')
# What Electron links against directly, less what every Arch system has
# (glibc, gcc-libs, systemd-libs). xdg-utils opens links and folders.
depends=(
  'alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'glib2' 'gtk3' 'libcups'
  'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes'
  'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'xdg-utils'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
# Electron ships stripped, and has no debug symbols to split off.
options=('!strip' '!debug')
# The .deb holds Electron's license, not the app's.
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/shovon/pbnotes/v$pkgver/LICENSE")
source_x86_64=("$_pkgname-$pkgver-x86_64.deb::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_amd64.deb")
source_aarch64=("$_pkgname-$pkgver-aarch64.deb::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_arm64.deb")
sha256sums=('SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  # -p keeps chrome-sandbox setuid, as the .deb has it and as Arch's own
  # chromium ships it. Arch allows the user-namespace sandbox, but a kernel
  # that doesn't (linux-hardened) needs this one. Debian's lintian overrides
  # and copyright file have no use here.
  bsdtar -xpf data.tar.* -C "$pkgdir" \
    --exclude './usr/share/lintian' --exclude './usr/share/doc'
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
